# Copy to .env for local dev (never commit .env).

# Your org's My Domain instance URL, e.g. https://orgfarm-292ccceca3.my.salesforce.com
SF_LOGIN_URL=

# Consumer Key / Secret of an External Client App (or Connected App) with the Web Server
# OAuth flow enabled, scopes: api id web refresh_token, and a callback URL matching this
# app's /auth/callback (http://localhost:5173/auth/callback for local dev via Vite proxy,
# your Heroku URL + /auth/callback once deployed).
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Casey's Bot Id in your org (Setup → find the Help Agent, or query BotDefinition).
CASEY_AGENT_ID=

# Set once you know it, after `heroku create` / first deploy. Leave blank for local dev.
APP_URL=

SESSION_SECRET=change-me-to-anything-random
